# Frontend API base URL (optional).
# - Dev: leave empty to use the Vite proxy at /api
# - Production (Vercel): leave empty — contact uses /api/messages serverless function
# - Only set this if you host the Express backend elsewhere for GitHub proxy routes
VITE_API_URL=

